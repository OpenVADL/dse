model TargetIsa () : Id = {RV32ICustomCrc1}

import "../rv32iCustom"::{RV32ICustomCrcBase, RV32ICustomCrc0, RV32ICustomCrc1, RV32ICustomCrc2, RV32ICustomCrc}
  with (AsStr("TargetIsa=", $TargetIsa))

micro architecture ThreeStage implements $TargetIsa() = {
  stage IF -> FetchResult = {
    IF := fetchNext
  }

  stage ID -> Instruction = {
    let instr = decode(IF) in {
      instr.address(@X)
      instr.read(@X)
      instr.read(@PC)
      ID := instr
    }
  }

  stage EX -> Instruction = {
    let instr = ID in {
      instr.write
      EX := instr
    }
  }
}
